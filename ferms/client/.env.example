# FERMS Client Environment Configuration
# Copy this file to .env and fill in values for your local setup.

# Base URL for the Express API server (no trailing slash)
VITE_API_URL=http://localhost:4000/api

# Base URL for the Socket.IO server (used by incident real-time updates)
VITE_SOCKET_URL=http://localhost:4000

# Set to 'true' to enable MSW mock service worker for all API calls.
# Set to 'false' to bypass all mocks and hit the real server for everything.
VITE_USE_MOCKS=true

# Comma-separated list of /api/* path prefixes that should bypass MSW and
# go to the real Express server. Only effective when VITE_USE_MOCKS=true.
# Leave empty to mock everything.
#
# NOTE: /api/auth is intentionally excluded below because auth.routes.js is
# still a stub (Parth's W2 work). Once real JWT auth is wired up, add it here.
# NOTE: /api/users is excluded because user.routes.js is also an empty stub.
# The axiosInstance sends x-dev-role + x-dev-station-id headers so the real
# Express server can authenticate requests in non-production (dev) mode.
#
# Example — route station/vehicle/personnel to real server:
#   VITE_REAL_API_PREFIXES=/api/stations,/api/vehicles,/api/personnel
VITE_REAL_API_PREFIXES=
